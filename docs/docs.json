{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Envshare",
  "description": "Learn how to install Envshare, securely send and receive dotenv files, run commands with temporary values, and operate a private libp2p relay.",
  "colors": {
    "primary": "#5757D9"
  },
  "logo": {
    "light": "/logo.svg",
    "dark": "/logo.svg",
    "href": "https://envshare.xyz/docs"
  },
  "favicon": "/logo.svg",
  "icons": {
    "library": "lucide"
  },
  "navigation": {
    "groups": [
      {
        "group": "Start",
        "icon": "sparkles",
        "pages": ["index", "quickstart", "installation"]
      },
      {
        "group": "Use Envshare",
        "icon": "send",
        "pages": ["sharing", "run", "troubleshooting"]
      },
      {
        "group": "Understand",
        "icon": "shield-check",
        "pages": ["how-it-works", "security"]
      },
      {
        "group": "Reference",
        "icon": "terminal",
        "pages": ["cli", "networks", "self-hosting"]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "type": "github",
        "href": "https://github.com/envoy1084/envshare"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get started",
      "href": "/quickstart"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/envoy1084/envshare"
    }
  },
  "banner": {
    "content": "Envshare 0.x is early software. Use test credentials until it has completed an independent security review.",
    "dismissible": true,
    "type": "warning"
  },
  "search": {
    "prompt": "Search Envshare docs"
  },
  "metadata": {
    "timestamp": true
  }
}
